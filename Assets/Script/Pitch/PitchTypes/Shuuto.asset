  _selectionReason: "\u672C\u4EBA\u304C\u8AAC\u660E\u3057\u305F\u3001\u76F4\u7403\u306B\u8FD1\u3044\u63E1\u308A\u3068\u8155\u306E\u632F\u308A\u304B\u3089\u5185\u89D2\u3078\u98DF\u3044\u8FBC\u3080\u30AB\u30DF\u30BD\u30EA\u30B7\u30E5\u30FC\u30C8\u3092\u53C2\u8003\u306B\u63A1\u7528\u3002145km/h\u306F\u672C\u4EBA\u306E\u300C145\u30AD\u30ED\u4EE5\u4E0A\u300D\u3068\u3044\u3046\u56DE\u60F3\u306E\u4E0B\u9650\u3002\u5909\u5316\u91CF\u306E\u5B9F\u6E2C\u9806\u4F4D\u306F\u672A\u78BA\u5B9A\u3002"
  _parameterNotes: "\u57fa\u672c\u7403\u7a2e\u7528\u306b\u63a8\u5b9a\u3057\u305f3D\u56de\u8ee2\u8ef8\u3002+Z\u3078\u6295\u3052\u308b\u53f3\u6295\u624b\u3092\u60f3\u5b9a\u3057\u3001\u76f4\u4ea4\u56de\u8ee2\u306e\u5272\u5408\u3092\u7d0472%\u3001\u4e3b\u306a\u5909\u5316\u3092\u8155\u5074\u30fb\u4e0a\u306b\u8a2d\u5b9a\u3057\u305f\u3002\u8155\u5074\u306e\u6a2a\u5909\u5316\u3092\u4e3b\u4f53\u306b\u3001\u30d0\u30c3\u30af\u30b9\u30d4\u30f3\u3082\u6b8b\u3059\u3002\u30b8\u30e3\u30a4\u30ed\u6210\u5206\u306f\u901a\u5e38\u65b9\u5411\u306e-Z\u3068\u4eee\u5b9a\u3057\u305f\u3002\u7403\u901f\u30fb\u7dcf\u56de\u8ee2\u6570\u3068\u53c2\u8003\u8cc7\u6599\u306f\u5f93\u6765\u306e\u5024\u3092\u7dad\u6301\u3057\u3066\u3044\u308b\u304c\u3001\u3053\u306e\u8ef8\u306f\u53c2\u8003\u9078\u624b\u306e\u5b9f\u6e2c\u5024\u3067\u306f\u306a\u3044\u3002"
