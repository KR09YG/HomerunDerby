  _referencePeriod: "\u73FE\u5F79\u671F\u306E\u30B7\u30E5\u30FC\u30C8\u306B\u3064\u3044\u3066\u306E2018\u5E74\u30A4\u30F3\u30BF\u30D3\u30E5\u30FC\u3002\u7279\u5B9A\u30B7\u30FC\u30BA\u30F3\u306E\u5B9F\u6E2C\u5024\u306A\u3057"
