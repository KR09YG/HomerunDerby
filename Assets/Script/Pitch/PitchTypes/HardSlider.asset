  _selectionReason: "2015\u301C2026\u5E74\u306E\u65E5\u672C\u4EBAMLB\u6295\u624B\u3001\u5E74\u9593100\u7403\u4EE5\u4E0A\u30FB\u5E73\u5747140km/h\u4EE5\u4E0A\u306ESL\u5206\u985E\u5185\u3067\u6A2A\u5909\u5316\u304C\u6700\u5927\u3060\u3063\u305F\u30B7\u30FC\u30BA\u30F3\u3092\u63A1\u7528\u3002\u516C\u958B\u96C6\u8A08\u306E1121\u7403\u3001\u6A2A\u5909\u53162.9\u30A4\u30F3\u30C1\u3001\u8A98\u5C0E\u7E26\u5909\u53163.8\u30A4\u30F3\u30C1\u3092\u53C2\u8003\u306B\u3057\u305F\u3002\u72EC\u7ACB\u3057\u305F\u7403\u7A2E\u5206\u985E\u3084\u65E5\u672C\u4EBA\u6B74\u4EE31\u4F4D\u3092\u4FDD\u8A3C\u3059\u308B\u8A2D\u5B9A\u3067\u306F\u306A\u3044\u3002"
  _parameterNotes: "\u57fa\u672c\u7403\u7a2e\u7528\u306b\u63a8\u5b9a\u3057\u305f3D\u56de\u8ee2\u8ef8\u3002+Z\u3078\u6295\u3052\u308b\u53f3\u6295\u624b\u3092\u60f3\u5b9a\u3057\u3001\u76f4\u4ea4\u56de\u8ee2\u306e\u5272\u5408\u3092\u7d0412%\u3001\u4e3b\u306a\u5909\u5316\u3092\u30b0\u30e9\u30d6\u5074\u30fb\u3084\u3084\u4e0a\u306b\u8a2d\u5b9a\u3057\u305f\u3002\u9ad8\u901f\u306e\u30b8\u30e3\u30a4\u30ed\u4e3b\u4f53\u3067\u5c0f\u3055\u304f\u30b0\u30e9\u30d6\u5074\u3078\u52d5\u304f\u3002\u30b8\u30e3\u30a4\u30ed\u6210\u5206\u306f\u901a\u5e38\u65b9\u5411\u306e-Z\u3068\u4eee\u5b9a\u3057\u305f\u3002\u7403\u901f\u30fb\u7dcf\u56de\u8ee2\u6570\u3068\u53c2\u8003\u8cc7\u6599\u306f\u5f93\u6765\u306e\u5024\u3092\u7dad\u6301\u3057\u3066\u3044\u308b\u304c\u3001\u3053\u306e\u8ef8\u306f\u53c2\u8003\u9078\u624b\u306e\u5b9f\u6e2c\u5024\u3067\u306f\u306a\u3044\u3002"
