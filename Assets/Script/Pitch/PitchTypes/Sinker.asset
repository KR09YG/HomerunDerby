  _selectionReason: "\u672C\u4EBA\u306E\u56DE\u60F3\u3068\u7403\u56E3\u8CC7\u6599\u3092\u57FA\u306B\u3001\u6D6E\u304D\u4E0A\u304C\u3063\u3066\u304B\u3089\u6C88\u3080\u65E5\u672C\u5F0F\u30B7\u30F3\u30AB\u30FC\u306E\u53C2\u8003\u4F8B\u3068\u3057\u3066\u63A1\u7528\u3002\u516C\u958B\u3055\u308C\u305F110\u301C115km/h\u306E\u4E2D\u9593\u5024\u3092\u4F7F\u7528\u3002\u5909\u5316\u91CF\u306E\u5171\u901A\u8A08\u6E2C\u5024\u306F\u306A\u304F\u3001\u6B74\u4EE3\u6700\u5927\u306E\u9806\u4F4D\u306F\u672A\u78BA\u5B9A\u3002"
  _parameterNotes: "\u57fa\u672c\u7403\u7a2e\u7528\u306b\u63a8\u5b9a\u3057\u305f3D\u56de\u8ee2\u8ef8\u3002+Z\u3078\u6295\u3052\u308b\u53f3\u6295\u624b\u3092\u60f3\u5b9a\u3057\u3001\u76f4\u4ea4\u56de\u8ee2\u306e\u5272\u5408\u3092\u7d0448%\u3001\u4e3b\u306a\u5909\u5316\u3092\u8155\u5074\u30fb\u3084\u3084\u4e0b\u306b\u8a2d\u5b9a\u3057\u305f\u3002\u6a2a\u56de\u8ee2\u3092\u4e3b\u4f53\u306b\u3057\u3001\u76f4\u7403\u3088\u308a\u63da\u529b\u3092\u6e1b\u3089\u3059\u3002\u30b8\u30e3\u30a4\u30ed\u6210\u5206\u306f\u901a\u5e38\u65b9\u5411\u306e-Z\u3068\u4eee\u5b9a\u3057\u305f\u3002\u7403\u901f\u30fb\u7dcf\u56de\u8ee2\u6570\u3068\u53c2\u8003\u8cc7\u6599\u306f\u5f93\u6765\u306e\u5024\u3092\u7dad\u6301\u3057\u3066\u3044\u308b\u304c\u3001\u3053\u306e\u8ef8\u306f\u53c2\u8003\u9078\u624b\u306e\u5b9f\u6e2c\u5024\u3067\u306f\u306a\u3044\u3002"
