  _referencePeriod: "\u516C\u958B\u3055\u308C\u305F\u6295\u7403\u30FB\u672C\u4EBA\u3084\u6307\u5C0E\u8005\u306E\u8AAC\u660E\u3092\u53C2\u8003\u3002\u7279\u5B9A\u30B7\u30FC\u30BA\u30F3\u306E\u5B9F\u6E2C\u5E73\u5747\u5024\u306A\u3057"
  _sourceUrls:
